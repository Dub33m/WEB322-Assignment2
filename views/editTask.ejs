<!DOCTYPE html>
<html lang="en" data-theme="cupcake">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Edit Task</title>

<link href="/css/main.css" rel="stylesheet">

</head>

<body>

<%- include("partials/navbar") %>

<div class="hero min-h-screen bg-base-200">

<div class="hero-content w-full max-w-lg">

<div class="card bg-base-100 shadow-xl w-full">

<div class="card-body">

<h1 class="text-3xl font-bold text-center">

Edit Task

</h1>

<form method="POST" action="/tasks/edit/<%= task.id %>">

<label class="label">

Title

</label>

<input
type="text"
name="title"
class="input input-bordered w-full"
value="<%= task.title %>"
required>

<label class="label mt-4">

Description

</label>

<textarea
name="description"
class="textarea textarea-bordered w-full"><%= task.description %></textarea>

<label class="label mt-4">

Due Date

</label>

<input
type="date"
name="dueDate"
class="input input-bordered w-full"
value="<%= task.dueDate ? task.dueDate.toISOString().split('T')[0] : '' %>">

<label class="label mt-4">

Status

</label>

<select
name="status"
class="select select-bordered w-full">

<option value="pending" <%= task.status === "pending" ? "selected" : "" %>>

Pending

</option>

<option value="completed" <%= task.status === "completed" ? "selected" : "" %>>

Completed

</option>

</select>

<button class="btn btn-primary w-full mt-6">

Update Task

</button>

</form>

</div>

</div>

</div>

</div>

</body>

</html>